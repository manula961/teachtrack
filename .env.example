NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Server-only. Required ONLY to run `npm run demo:setup`.
# Never prefix this with NEXT_PUBLIC and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Safety confirmation required by the demo-account setup script.
# Set only against a competition/demo Supabase project.
ALLOW_DEMO_ACCOUNT_SETUP=NO

# Google Drive evidence storage (server-only).
GOOGLE_DRIVE_FOLDER_ID=YOUR_PRIVATE_DRIVE_FOLDER_ID

# Option A — recommended for a normal My Drive folder:
GOOGLE_DRIVE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_DRIVE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_DRIVE_REFRESH_TOKEN=YOUR_LONG_LIVED_REFRESH_TOKEN

# Option B — Google Workspace Shared Drive:
# Service accounts cannot own ordinary My Drive files, so use this mode with
# a Shared Drive and add the service account as a member/content manager.
GOOGLE_SERVICE_ACCOUNT_EMAIL=teachtrack-evidence@YOUR_PROJECT.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
